{
  "datasets": [
    {
      "name": "ds_kpis",
      "displayName": "KPIs gerais",
      "queryLines": [
        "SELECT\n",
        "  count(*) as total_avaliacoes,\n",
        "  round(avg(case when flag_concordancia then 1.0 else 0.0 end) * 100, 1) as pct_concordancia,\n",
        "  round(avg(pontuacao_seguranca), 2) as pontuacao_media,\n",
        "  round(avg(case when transicao_efetivada_real then 1.0 else 0.0 end) * 100, 1) as pct_efetivacao\n",
        "FROM pipeline_tcc.ouro.mart_transicoes\n"
      ]
    },
    {
      "name": "ds_hospital",
      "displayName": "Operacional por hospital",
      "queryLines": [
        "SELECT * FROM pipeline_tcc.ouro.mart_operacional_hospital ORDER BY hospital\n"
      ]
    },
    {
      "name": "ds_profissional",
      "displayName": "Operacional por profissional",
      "queryLines": [
        "SELECT * FROM pipeline_tcc.ouro.mart_operacional_profissional ORDER BY nome_profissional\n"
      ]
    },
    {
      "name": "ds_direcao",
      "displayName": "Distribuicao por direcao",
      "queryLines": [
        "SELECT direcao_transicao, count(*) as total FROM pipeline_tcc.ouro.mart_transicoes GROUP BY direcao_transicao\n"
      ]
    },
    {
      "name": "ds_transicoes",
      "displayName": "Transicoes (detalhe)",
      "queryLines": [
        "SELECT hospital, nome_profissional, data_avaliacao, estado_atual, direcao_transicao, direcao_recomendada_calculada, flag_concordancia, transicao_efetivada_real, pontuacao_seguranca FROM pipeline_tcc.ouro.mart_transicoes ORDER BY data_avaliacao\n"
      ]
    }
  ],
